{
    "compilerOptions": {
        "target": "ES2018",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "ES2018"],
        "strict": true,
        "noImplicitAny": true,
        "isolatedModules": true,
        "importHelpers": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["src/"]
}
