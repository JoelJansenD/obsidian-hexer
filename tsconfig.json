{
    "compilerOptions": {
        "target": "ES2019",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["DOM", "ES2019"],
        "strict": true,
        "resolveJsonModule": true,
        "noImplicitAny": true,
        "isolatedModules": true,
        "importHelpers": true,
        "skipLibCheck": true,
        "types": ["vitest/globals"]
    },
    "include": ["src/"]
}
