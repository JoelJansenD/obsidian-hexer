{
  "name": "obsidian-hexer",
  "version": "0.1.0",
  "description": "A hex map editor plugin for Obsidian.",
  "homepage": "https://github.com/JoelJansenD/obsidian-hexer#readme",
  "bugs": {
    "url": "https://github.com/JoelJansenD/obsidian-hexer/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoelJansenD/obsidian-hexer.git"
  },
  "license": "GPL-3.0",
  "author": "JoelJansenD",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "wdio run ./wdio.conf.ts tsConfigPath=./tsconfig.e2e.json"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.1.1",
    "@wdio/cli": "^9.29.1",
    "@wdio/cucumber-framework": "^9.29.1",
    "@wdio/local-runner": "^9.29.1",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-boundaries": "^7.0.2",
    "happy-dom": "^20.11.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "~5.8",
    "typescript-eslint": "^8.64.0",
    "vitest": "^4.1.10",
    "wdio-obsidian-reporter": "^3.1.1",
    "wdio-obsidian-service": "^3.1.1"
  },
  "dependencies": {
    "lucide": "^1.24.0"
  }
